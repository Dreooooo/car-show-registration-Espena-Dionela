
@Api_HostAddress = http://localhost:5205

### CASE 01 - Valid Competitor, partly paid
POST {{Api_HostAddress}}/api/registrations
Content-Type: application/json

{
  "participantName": "Juan Dela Cruz",
  "contactNumber": "09171234567",
  "email": "juan.delacruz@example.com",
  "address": "123 Rizal St., Naga City",
  "carMakeModel": "Toyota Supra MK4",
  "plateNumber": "TST 1001",
  "registrationType": "Competitor",
  "amountPaid": 1000
}

### CASE 02 - Valid Exhibitor, not paid
POST {{Api_HostAddress}}/api/registrations
Content-Type: application/json

{
  "participantName": "Maria Santos",
  "contactNumber": "09181234567",
  "email": "maria.santos@example.com",
  "address": "Naga City",
  "carMakeModel": "Honda Civic",
  "plateNumber": "TST 1002",
  "registrationType": "Exhibitor",
  "amountPaid": 0
}

### CASE 03 - Valid VIP, fully paid
POST {{Api_HostAddress}}/api/registrations
Content-Type: application/json

{
  "participantName": "Pedro Reyes",
  "contactNumber": "09191234567",
  "email": "pedro.reyes@example.com",
  "address": "Legazpi City",
  "carMakeModel": "BMW M4",
  "plateNumber": "TST 1003",
  "registrationType": "VIP",
  "amountPaid": 5000
}

### CASE 04 - Registration number increases
GET {{Api_HostAddress}}/api/registrations?page=1&pageSize=50
Accept: application/json

### CASE 05 - Client tries to set server-only fields
POST {{Api_HostAddress}}/api/registrations
Content-Type: application/json

{
  "participantName": "Test Server Fields",
  "contactNumber": "09201234567",
  "email": "serverfields@example.com",
  "address": "Sorsogon City",
  "carMakeModel": "Toyota Vios",
  "plateNumber": "TST 1005",
  "registrationType": "VIP",
  "amountPaid": 0,
  "registrationFee": 1,
  "status": "Confirmed",
  "registrationNumber": "HACK-1"
}

### CASE 06 - All text fields empty
POST {{Api_HostAddress}}/api/registrations
Content-Type: application/json

{
  "participantName": "",
  "contactNumber": "",
  "email": "",
  "address": "",
  "carMakeModel": "",
  "plateNumber": "",
  "registrationType": "Competitor",
  "amountPaid": 0
}

